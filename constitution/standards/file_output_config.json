## ⚙️ 核心配置

```json
{
  "file_output": {
    "default_format": "markdown",
    "default_extension": ".md",
    "send_via_telegram": true,
    "telegram_method": "sendDocument",
    "include_caption": true,
    "caption_requirements": {
      "title": true,
      "key_data": true,
      "recommendations": true,
      "timestamp": true,
      "agent_signature": true
    },
    "exception_handling": {
      "customer_request": "use_customer_format",
      "fallback_format": "markdown",
      "log_exceptions": true
    }
  },
  "supported_formats": {
    "default": ".md",
    "optional": [".pdf", ".xlsx", ".docx", ".pptx", ".json", ".csv", ".txt", ".html"]
  },
  "quality_checks": {
    "before_send": [
      "format_valid",
      "header_complete",
      "data_verified",
      "recommendations_clear",
      "footer_complete"
    ],
    "after_send": [
      "send_success_confirmed",
      "file_accessible",
      "no_encoding_issues",
      "git_committed"
    ]
  },
  "effective_date": "2026-04-19T10:58:00+08:00",
  "priority": "tier_1",
  "scope": "all_taiyi_systems"
}
```

