{
  "evolution": {
    "enabled": true,
    "update_interval": 3600,
    "min_samples": 10,
    "learning_rate": 0.1,
    "exploration_rate": 0.1
  },
  "metrics": {
    "success_rate_threshold": 0.7,
    "response_time_threshold": 5.0,
    "quality_threshold": 0.8
  },
  "strategies": {
    "engine_selection": {
      "high_quality": "google",
      "balanced": "bing",
      "fast": "duckduckgo"
    },
    "proxy_rotation": {
      "enabled": true,
      "strategy": "round_robin",
      "failover": true
    },
    "anti_scraping": {
      "delay_range": [1, 3],
      "max_retries": 3,
      "user_agent_rotation": true
    }
  },
  "knowledge_base": {
    "max_strategies": 50,
    "max_failures": 50,
    "retention_days": 30
  }
}