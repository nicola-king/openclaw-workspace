{
  "module": "conversion-optimizer",
  "version": "9.0.0",
  "funnel": {
    "enabled": true,
    "stages": ["awareness", "interest", "decision", "action"],
    "update_frequency": "daily"
  },
  "roi": {
    "enabled": true,
    "metrics": ["cost", "revenue", "efficiency", "payback_period"],
    "update_frequency": "weekly"
  },
  "channel": {
    "enabled": true,
    "channels": ["email", "linkedin", "whatsapp", "wechat", "phone"],
    "update_frequency": "weekly"
  },
  "ab_test": {
    "enabled": true,
    "variables": ["headline", "content", "timing", "channel"],
    "min_sample_size": 1000,
    "confidence_level": 0.95
  }
}
