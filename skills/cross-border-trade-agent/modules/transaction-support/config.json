{
  "module": "transaction-support",
  "version": "9.0.0",
  "logistics": {
    "enabled": true,
    "providers": ["cosco", "dhl", "fedex", "maersk"],
    "routes": ["中国→澳大利亚", "中国→东南亚", "中国→中东"],
    "update_frequency": "weekly"
  },
  "price": {
    "enabled": true,
    "platforms": ["alibaba", "made-in-china", "global-sources"],
    "update_frequency": "daily"
  },
  "forecast": {
    "enabled": true,
    "period": "12m",
    "method": "time_series",
    "confidence_threshold": 0.7
  },
  "multilingual": {
    "enabled": true,
    "languages": ["en", "zh", "es", "ar", "fr", "de"],
    "templates": ["greeting", "product_intro", "quotation", "closing"]
  }
}
