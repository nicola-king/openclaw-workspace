# 太一智能路由系统 - API Key 配置
# 创建时间：2026-04-23 14:55
# 使用说明：填入你的 API Key 后，执行 source config/api-keys.env

# ===========================================
# 百炼 API (Qwen 系列模型)
# ===========================================
# 获取地址：https://dashscope.console.aliyun.com/apiKey
# 配额：免费额度 + 按量付费
# 用途：qwen3.5-plus, qwen3-coder-plus
export DASHSCOPE_API_KEY="sk-你的百炼 API Key"

# ===========================================
# Gemini API (Google)
# ===========================================
# 获取地址：https://makersuite.google.com/app/apikey
# 配额：免费额度 (60 次/分钟)
# 用途：gemini-2.5-pro (长文本备用)
export GEMINI_API_KEY="你的 Gemini API Key"

# ===========================================
# 本地模型 (Ollama)
# ===========================================
# 无需 API Key，本地运行
# 端点：http://localhost:11434
# 模型：qwen2.5:7b-instruct-q4_K_M
export OLLAMA_ENDPOINT="http://localhost:11434"

# ===========================================
# 验证配置
# ===========================================
# 执行以下命令验证：
#   source config/api-keys.env
#   echo $DASHSCOPE_API_KEY
#   python3 scripts/check-bailian-quota.py
