  "discovery_rules": [
    {
      "name": "关键词匹配",
      "type": "keyword",
      "priority": 1,
      "description": "根据用户输入关键词匹配 Agent",
      "examples": {
        "交易": "知几",
        "买/卖": "知几",
        "文章/内容": "山木",
        "健康/养生": "素问",
        "系统/监控": "罔两",
        "脚本/工具": "庖丁"
      }
    },
    {
      "name": "场景匹配",
      "type": "scenario",
      "priority": 2,
      "description": "根据使用场景推荐 Agent",
      "examples": {
        "需要交易建议": "知几",
        "写公众号": "山木",
        "身体不适": "素问",
        "系统异常": "罔两",
        "自动化需求": "庖丁"
      }
    },
    {
      "name": "能力匹配",
      "type": "capability",
      "priority": 3,
      "description": "根据所需能力匹配 Agent",
      "examples": {
        "市场分析": "知几",
        "内容创作": "山木",
        "健康评估": "素问",
        "性能分析": "罔两",
        "代码开发": "庖丁"
      }
    },
    {
      "name": "历史偏好",
      "type": "history",
      "priority": 4,
      "description": "基于用户历史选择推荐",
      "weight": 0.8
    }
  ],
  
  "recommendation_engine": {
    "enabled": true,
    "algorithm": "hybrid",
    "factors": [
      {
        "name": "关键词匹配度",
        "weight": 0.3
      },
      {
        "name": "场景匹配度",
        "weight": 0.3
      },
      {
        "name": "能力匹配度",
        "weight": 0.2
      },
      {
        "name": "历史偏好",
        "weight": 0.2
      }
    ],
    "min_confidence": 0.6,
    "max_recommendations": 3
  },
  
  "ui_config": {
    "display_mode": "card",
    "show_capabilities": true,
    "show_scenarios": true,
    "quick_actions": [
      "查看 Agent 详情",
      "调整个性配置",
      "查看工作流程",
      "查看历史表现"
    ]
  }
}
