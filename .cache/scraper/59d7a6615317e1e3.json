 shadow name\">\n                    </div>\n                  </div>\n                </div><!--item end-->\n                <div class=\"layui-table-item buttons\">\n                  <div class=\"layui-table-block\">\n                    <div class=\"layui-input-block\">\n                      <ul class=\"col3 clearfix\">\n                        <li>\n                          <span><button type=\"button\" class=\"layui-btn layui-btn-submit\">提 交</button></span>\n                        </li>\n                        <li>\n                          <span><button type=\"button\" class=\"layui-btn layui-btn-reset\">重 置</button></span>\n                        </li>\n                      </ul>\n                    </div>\n                  </div>\n                </div><!--item end-->\n                <div class=\"clear\"></div>\n              </div>\n            </div>\n            \n            <div class=\"searchtip\">例如 商品名称：改良种用濒危野马，商品代码：0101210010</div>\n          </div><!--search end-->\n          <div class=\"tab-brief small black normal\">\n            <div class=\"hd mb30 clearfix\">\n              <ul class=\"clearfix\">\n                <li class=\"on\"> \n                  <a>查询结果</a>\n                </li>\n              </ul>\n            </div>\n            \n            <div class=\"table-list tslcx-list res radius mb20\">\n              <ul class=\"clearfix\">\n                <li class=\"head\">\n                  <div class=\"c-topic\">\n                    <span>商品名称</span>\n                  </div>\n                  <div class=\"c-num\">\n                    <span>商品编码</span>\n                  </div>\n                  <div class=\"c-unit\">\n                    <span>计量单位</span>\n                  </div>\n                  <div class=\"c-zssl\">\n                    <span>征税税率%</span>\n                  </div>\n                  <div class=\"c-zzssl\">\n                    <span>增值税退税率%</span>\n                  </div>\n                  <div class=\"c-tsspbs\">\n                    <span>特殊商品标识</span>\n                  </div>\n                </li>\n              </ul>\n              <ul class=\"clearfix\" id=\"ckts\">\n                \n              </ul>\n              <div class=\"\" id=\"pages\"></div>\n            </div>\n      \n          </div>\n        </div>\n        <!--bd end-->\n      </div>\n    </div>\n    <!--box end-->\n  </div>\n  <!--container end-->\n</div>\n<!--wrapper end-->\n\n<!--footer start-->\n<script src=\"http://www.chinatax.gov.cn/chinatax/xhtml/js/foot.js\" type=\"text/javascript\" charset=\"utf-8\"></script><link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.chinatax.gov.cn/chinatax/xhtml/New_chinatax/libs/css/base.css\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.chinatax.gov.cn/chinatax/xhtml/New_chinatax/libs/layui/css/layui.css\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.chinatax.gov.cn/chinatax/xhtml/New_chinatax/static/2023/css/common.css\">\n<link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.chinatax.gov.cn/chinatax/xhtml/New_chinatax/static/2023/css/friendship.css\">\n    <script type=\"text/javascript\" src=\"http://www.chinatax.gov.cn/chinatax/xhtml/New_chinatax/libs/jquery.min.js\"></script>\n  <script type=\"text/javascript\" src=\"http://www.chinatax.gov.cn/chinatax/xhtml/New_chinatax/libs/jquery.SuperSlide.js\"></script>\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"http://www.chinatax.gov.cn/chinatax/xhtml/New_chinatax/static/2023/css/footer.css\">\n<div class=\"friendship-mode\">\n  <div class=\"container\">\n    <div class=\"gov\">\n      <a href=\"https://www.gov.cn/\" title=\"\" target=\"_blank\">\n        <i><img src=\"http://www.chinatax.gov.cn/chinatax/xhtml/New_chinatax/static/2023/images/public/gh.png\"></i>\n        <font>中国政府网</font>\n      </a>\n    </div>\n    <div class=\"friendlinks clearfix\">\n      <dl class=\"select\">\n        <dt class=\"menu\">国家税务总局各省级税务局<i class