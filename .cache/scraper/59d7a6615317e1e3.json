ch\">\n        <dl>\n          <dd>\n            <input type=\"text\" class=\"header-search-txt\" id=\"header-search-txt\" placeholder=\"请输入您要搜索的内容\" onfocus=\"if(value==\" 请输入您要搜索的内容')=\"\" {value=\"\" }'=\"\" onblur=\"if (value==\" ')=\"\" value=\"\" autocomplete=\"off\">\n          </dd>\n          <dt class=\"icon\"></dt>\n          <dt class=\"button\">\n            <input type=\"button\" class=\"submit\" id=\"header-search-btn\" value=\"搜一搜\">\n          </dt>\n        </dl>\n      <div class=\"hotwords\">\n        <span>本站热词：</span>\n            <a href=\"http://www.chinatax.gov.cn/search5/html/searchResult.html?siteCode=bm29000002&amp;searchWord=发票&amp;left_right_index=0&amp;searchSource=0\" class=\"fl cursor\">发票</a>\n                <a href=\"http://www.chinatax.gov.cn/search5/html/searchResult.html?siteCode=bm29000002&amp;searchWord=民营经济&amp;left_right_index=0&amp;searchSource=0\" class=\"fl cursor\">民营经济</a>\n                <a href=\"http://www.chinatax.gov.cn/search5/html/searchResult.html?siteCode=bm29000002&amp;searchWord=便民办税春风行动&amp;left_right_index=0&amp;searchSource=0\" class=\"fl cursor\">便民办税春风行动</a>\n                <a href=\"http://www.chinatax.gov.cn/search5/html/searchResult.html?siteCode=bm29000002&amp;searchWord=个税&amp;left_right_index=0&amp;searchSource=0\" class=\"fl cursor\">个税</a>\n                <a href=\"http://www.chinatax.gov.cn/search5/html/searchResult.html?siteCode=bm29000002&amp;searchWord=小微企业&amp;left_right_index=0&amp;searchSource=0\" class=\"fl cursor\">小微企业</a>\n      </div>\n    </div>\n  </div>\n  <div class=\"mainnav\">\n    <div class=\"container\">\n      <ul class=\"clearfix\">\n        <li class=\"navli navli0\">\n          <a href=\"http://www.chinatax.gov.cn/chinatax/index.html\">\n            <span>首页</span>\n          </a>\n        </li><!--首页-->\n        <li class=\"navli navli1\">\n          <a href=\"http://www.chinatax.gov.cn/chinatax/n810209/index.html\" target=\"_blank\" title=\"\">\n            <span>总局